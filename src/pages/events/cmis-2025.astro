---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/shared/Button.astro';
import Icon from '../../components/shared/Icon.astro';
import EventPhase from '../../components/shared/EventPhase.astro';
import ContentSection from '../../components/shared/ContentSection.astro';
import QuickInfoCards from '../../components/summit/QuickInfoCards.astro';
import ScheduleSection from '../../components/summit/ScheduleSection.astro';
import SpeakersSection from '../../components/cmis2025/SpeakersSection.astro';
import crowd from '../../assets/images/crowd.jpg';
import speaker from '../../assets/images/speaker.jpg';
import speaker2 from '../../assets/images/speaker2.jpg';
import crowd2 from '../../assets/images/crowd2.jpg';

const event = await getEntry('events', '2025-11-cmis-2025');
if (!event) throw new Error('Event 2025-11-cmis-2025 is missing from src/content/events/');

const quickInfo = [
  { icon: 'calendar', title: 'November 18th, 2025', subtitle: 'Save the date' },
  { icon: 'map-pin', title: 'Panum, University of Copenhagen', subtitle: 'Blegdamsvej 3B, 2200 Copenhagen N' },
  { icon: 'clock', title: '15:00 – 21:00', subtitle: 'Full evening program' },
];

const schedule = [
  {
    title: 'MedTech Careers',
    time: '15:00 – 17:30',
    detail: 'With Medicoindustrien Companies (e.g., Novo Nordisk)',
    price: 'FREE',
    free: true,
    note: 'Open to all students',
  },
  {
    title: 'Innovation Summit',
    time: '17:45 – 21:00',
    detail: 'Copenhagen MedTech Innovation Summit talks',
    price: '29 DKK',
    note: 'Includes dinner and beverages',
  },
];
---

<BaseLayout
  title="Copenhagen MedTech Innovation Summit 2025"
  description="Join us for the Copenhagen MedTech Innovation Summit 2025 on November 18th at Panum, University of Copenhagen. Featuring international networking, inspiring talks, and career opportunities."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Copenhagen MedTech Innovation Summit 2025",
      "startDate": "2025-11-18T15:00:00+01:00",
      "endDate": "2025-11-18T21:00:00+01:00",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": "Panum, University of Copenhagen",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Blegdamsvej 3B",
          "postalCode": "2200",
          "addressLocality": "Copenhagen N",
          "addressCountry": "DK"
        }
      },
      "organizer": {
        "@type": "Organization",
        "name": "Copenhagen MedTech",
        "url": "https://cphmedtech.dk"
      }
    })} />
  </Fragment>

  <section class="cmis-hero">
    <div class="cmis-hero__inner">
      <h1>Copenhagen MedTech Innovation Summit 2025</h1>
      <p class="cmis-hero__subtitle">
        An event exploring the intersection of artificial intelligence, medicine, and technology.
      </p>
      <div class="cmis-hero__cta">
        {event.data.registrationUrl && (
          <EventPhase date={event.data.sortDate} show="upcoming">
            <Button href={event.data.registrationUrl} variant="primary" size="lg" premium external>
              Sign Up Now
            </Button>
          </EventPhase>
        )}
        <EventPhase date={event.data.sortDate} show="past">
          <p class="cmis-hero__past">This event took place on {event.data.date}.</p>
          <a href="/events/cmis-2026/" class="link-arrow">
            See CMIS 2026 <Icon name="chevron-right" size={16} />
          </a>
        </EventPhase>
      </div>
      <QuickInfoCards cards={quickInfo} />
    </div>
  </section>

  <ContentSection
    heading="Innovation Summit 2025"
    imageSrc={crowd}
    imageAlt="Summit attendees networking"
  >
    <p>
      Our annual Innovation Summit, featuring MedTech Careers, an opportunity for students to connect with the MedTech industry.
    </p>
    <p>
      The evening will include inspiring talks, networking opportunities, dinner, and refreshments.
    </p>
  </ContentSection>

  <ContentSection
    heading="Outstanding Lineup of Industry Experts"
    imageSrc={speaker}
    imageAlt="Speaker presenting at the summit"
    reversed
    muted
  >
    <p>
      The program features industry speakers sharing their insights and experiences.
    </p>
    <p>
      Participants get to meet professionals and startups working in MedTech.
    </p>
  </ContentSection>

  <ContentSection
    heading="MedTech Careers"
    subtitle="In Collaboration with Medicoindustrien"
    imageSrc={speaker2}
    imageAlt="MedTech Careers session"
  >
    <p>
      In collaboration with Medicoindustrien and their partners, we are introducing a dedicated Career Day
      as part of the event: MedTech Careers.
    </p>
    <p>
      This segment gives students valuable opportunities to engage directly with industry representatives
      and explore future career paths.
    </p>
  </ContentSection>

  <ContentSection
    heading="Connect and Learn"
    imageSrc={crowd2}
    imageAlt="Attendees connecting at the event"
    reversed
    muted
  >
    <p>
      The Innovation Summit and MedTech Careers are about making real connections.
    </p>
    <p>
      This event offers a space to learn, network, and collaborate with fellow students and professionals in MedTech.
    </p>
  </ContentSection>

  <SpeakersSection />
  <ScheduleSection
    items={schedule}
    disclaimer="Participation in MedTech Careers is free, but a ticket is required for the Innovation Summit. The fee ensures attendance commitment."
    eventDate={event.data.sortDate}
    ticketUrl={event.data.registrationUrl}
  />

  <section class="cmis-footer">
    <p>
      You can find the event on LinkedIn
      <a href="https://www.linkedin.com/company/cph-medtech/" target="_blank" rel="noopener noreferrer" class="link-elegant">here</a>.
    </p>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/mixins' as *;

  .cmis-hero {
    padding: 5rem 0 3rem;
  }

  .cmis-hero__inner {
    @include container(72rem);
    text-align: center;

    h1 {
      font-size: 2.5rem;

      @include respond-to($bp-md) {
        font-size: 3.75rem;
      }
    }
  }

  .cmis-hero__subtitle {
    color: $color-muted-fg;
    max-width: 36rem;
    margin: 1rem auto 2rem;
  }

  .cmis-hero__cta {
    margin-bottom: 3rem;

    @include respond-to($bp-md) {
      margin-bottom: 4rem;
    }
  }

  .cmis-hero__past {
    color: $color-muted-fg;
    margin-bottom: 0.75rem;
  }

  .cmis-footer {
    padding: 3rem 0;
    text-align: center;
    @include container;

    p {
      color: $color-muted-fg;
    }
  }
</style>
