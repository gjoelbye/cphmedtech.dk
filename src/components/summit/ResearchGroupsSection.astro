---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getLogoSrc } from '../../utils/logos';
import Icon from '../shared/Icon.astro';

interface Props {
  eyebrow: string;
  intro: string;
  groups: NonNullable<CollectionEntry<'events'>['data']['researchGroups']>;
}

const { eyebrow, intro, groups } = Astro.props;

const cards = groups.map((group) => {
  const logo = getLogoSrc(group.logo);
  if (!logo) throw new Error(`Logo ${group.logo} for ${group.name} is missing from src/assets/logos/`);
  return { ...group, logoSrc: logo };
});
---

<section class="research">
  <div class="research__inner">
    <p class="research__eyebrow">{eyebrow}</p>
    <h2>Research Groups</h2>
    <p class="research__intro">{intro}</p>
    <div class="research__grid">
      {cards.map((group) => (
        <a href={group.website} target="_blank" rel="noopener noreferrer" class="research__card card">
          <div class="research__logo">
            <Image src={group.logoSrc} alt="" />
          </div>
          <div class="research__body">
            <p class="research__dept">{group.department}</p>
            <h3 class="research__name">{group.name}</h3>
            <p class="research__leader">Group leader: {group.leader}</p>
            <p class="research__desc">{group.description}</p>
            <span class="research__more link-arrow">
              Visit the group's page <Icon name="chevron-right" size={16} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/mixins' as *;

  .research {
    padding: 4rem 0;
  }

  .research__inner {
    @include container(72rem);
    text-align: center;

    h2 {
      margin-bottom: 0.75rem;
    }
  }

  .research__eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-primary;
    margin-bottom: 0.5rem;
  }

  .research__intro {
    color: $color-muted-fg;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  .research__grid {
    display: grid;
    gap: 1.5rem;
    text-align: left;

    @include respond-to($bp-md) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .research__card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    border-left: 4px solid $color-primary;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;

    &:hover .research__name {
      color: $color-primary;
    }
  }

  .research__logo {
    flex-shrink: 0;
    width: 3rem;

    img {
      width: 100%;
      height: auto;
    }
  }

  .research__body {
    min-width: 0;
  }

  .research__dept {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-muted-fg;
  }

  .research__name {
    font-size: 1.125rem;
    margin: 0.25rem 0;
    transition: $transition-base;
  }

  .research__leader {
    font-size: 0.875rem;
    font-weight: 500;
    color: $color-primary;
  }

  .research__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: $color-muted-fg;
    margin-top: 0.5rem;
  }

  .research__more {
    font-size: 0.875rem;
    margin-top: 0.75rem;
  }
</style>
