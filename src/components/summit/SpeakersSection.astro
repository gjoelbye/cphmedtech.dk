---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  speakers: CollectionEntry<'speakers'>[];
}

const { eyebrow, speakers } = Astro.props;

const photoModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/speakers/*', { eager: true });

function getPhoto(filename?: string): ImageMetadata | undefined {
  if (!filename) return undefined;
  const key = Object.keys(photoModules).find((k) => k.endsWith(`/${filename}`));
  if (!key) throw new Error(`Speaker photo ${filename} is missing from src/assets/images/speakers/`);
  return photoModules[key].default;
}

const cards = speakers.map((speaker) => ({ ...speaker.data, photoSrc: getPhoto(speaker.data.photo) }));
---

<section class="speakers">
  <div class="speakers__inner">
    <p class="speakers__eyebrow">{eyebrow}</p>
    <h2>Meet Our Speakers</h2>
    <div class="speakers__grid">
      {cards.map((speaker) => (
        <article class="speakers__card card">
          {speaker.photoSrc && (
            <div class="speakers__photo">
              <Image src={speaker.photoSrc} alt={`Portrait of ${speaker.name}`} width={288} height={288} />
            </div>
          )}
          <h3 class="speakers__name">{speaker.name}</h3>
          <p class="speakers__title">{speaker.title}</p>
          <p class="speakers__org">{speaker.organization}</p>
          {speaker.bio && <p class="speakers__bio">{speaker.bio}</p>}
        </article>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/mixins' as *;

  .speakers {
    padding: 4rem 0;
  }

  .speakers__inner {
    @include container(72rem);
    text-align: center;

    h2 {
      margin-bottom: 2.5rem;
    }
  }

  .speakers__eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-primary;
    margin-bottom: 0.5rem;
  }

  .speakers__grid {
    display: grid;
    gap: 1.5rem;

    @include respond-to($bp-md) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .speakers__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.5rem;
  }

  .speakers__photo {
    width: 9rem;
    height: 9rem;
    border-radius: $radius-full;
    overflow: hidden;
    border: 3px solid rgba($color-primary, 0.15);
    margin-bottom: 1.25rem;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
  }

  .speakers__name {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .speakers__title {
    font-size: 0.875rem;
    font-weight: 500;
    color: $color-primary;
  }

  .speakers__org {
    font-size: 0.875rem;
    color: $color-muted-fg;
    margin-bottom: 1rem;
  }

  .speakers__bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: $color-muted-fg;
    text-align: left;
  }
</style>
