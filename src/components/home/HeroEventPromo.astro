---
import type { CollectionEntry } from 'astro:content';
import Icon from '../shared/Icon.astro';
import EventPhase from '../shared/EventPhase.astro';

interface Props {
  event: CollectionEntry<'events'>;
}

const { title, sortDate, pageUrl } = Astro.props.event.data;
const day = sortDate.getUTCDate();
const month = sortDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
---

<EventPhase date={sortDate} show="upcoming">
  <a href={pageUrl} class="hero-promo card">
    <span class="hero-promo__date">
      <span class="hero-promo__day">{day}</span>
      <span class="hero-promo__month">{month}</span>
    </span>
    <span class="hero-promo__body">
      <span class="hero-promo__eyebrow">Next event</span>
      <span class="hero-promo__title">{title}</span>
      <span class="hero-promo__cta">Program and tickets <Icon name="chevron-right" size={14} /></span>
    </span>
  </a>
</EventPhase>

<style lang="scss">
  @use '../../styles/tokens' as *;

  .hero-promo {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem 1rem 1rem;
    box-shadow: $shadow-md;

    &:hover {
      box-shadow: $shadow-lg;
    }
  }

  .hero-promo__date {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: $radius;
    background: $color-surface;
  }

  .hero-promo__day {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1;
    color: $color-primary;
  }

  .hero-promo__month {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: $color-fg-muted;
    margin-top: 0.125rem;
  }

  .hero-promo__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .hero-promo__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-primary;

    &::before {
      content: '';
      width: 0.5rem;
      height: 0.5rem;
      border-radius: $radius-full;
      background: $color-success;
      animation: hero-promo-pulse 2s ease-out infinite;
    }
  }

  .hero-promo__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: $color-fg;
  }

  .hero-promo__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: $color-primary;
    transition: gap 0.2s ease;

    .hero-promo:hover & {
      gap: 0.5rem;
    }
  }

  @keyframes hero-promo-pulse {
    0% { box-shadow: 0 0 0 0 rgba($color-success, 0.5); }
    70% { box-shadow: 0 0 0 0.375rem rgba($color-success, 0); }
    100% { box-shadow: 0 0 0 0 rgba($color-success, 0); }
  }
</style>
